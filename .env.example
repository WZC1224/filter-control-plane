# 复制为 .env 后填写。不配 DATA818_* 时使用 MockAdapter。

FLASK_ENV=development
SECRET_KEY=change-me-filter-control-plane
JWT_SECRET=change-me-jwt-secret
DATABASE_URL=sqlite:///fcp.db

# 控制平面默认管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# data818 下游（可选）
# BASE 用 API 根，例如 https://api.818gzs.ai （不要填前台 www）
# TOKEN：agent_token 仅通 /api/filter/*；业务列表/订单需登录 JWT
DATA818_BASE_URL=
DATA818_TOKEN=
DATA818_TIMEOUT=60
