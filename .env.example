# 复制为 .env 后填写。不配下游凭证时使用 MockAdapter。

FLASK_ENV=development
SECRET_KEY=change-me-filter-control-plane
JWT_SECRET=change-me-jwt-secret
DATABASE_URL=sqlite:///fcp.db

# 控制平面默认管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 独占下游：auto | mock | data818 | data_center
# auto：data_center 三件套齐 → data_center；否则 DATA818 齐 → data818；否则 mock
# 显式指定缺凭证会启动失败（不静默回退）
DOWNSTREAM=auto

# data818 下游（可选）
# BASE 用 API 根，例如 https://api.818gzs.ai （不要填前台 www）
# TOKEN：登录 JWT（浏览器 Authorization，带 exp）→ 列表/订单/价目/公告/账单
# AGENT_TOKEN：超管签发 agent_token（exp 常为 null）→ /api/filter/* 建任务/类型/余额/下载
# 818 两套 JWT 密钥不同，缺一则对应半边接口 401
DATA818_BASE_URL=
DATA818_TOKEN=
DATA818_AGENT_TOKEN=
DATA818_TIMEOUT=60

# data-center-backend 下游（可选；与 data818 独占，勿同时当真用）
# BASE 例：https://filter.168studio.com 或 http://host:9999
# API_KEY：开放筛选 /api/filter* 的 X-Api-Key
# TOKEN：登录 JWT → 任务列表/订单/账单/关退等
DATA_CENTER_BASE_URL=
DATA_CENTER_API_KEY=
DATA_CENTER_TOKEN=
DATA_CENTER_TIMEOUT=60
