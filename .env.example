# 复制为 .env 后填写。不配下游凭证时使用 MockAdapter。

# development | production（production 拒绝弱 SECRET/JWT/ADMIN_PASSWORD，并用 waitress）
FLASK_ENV=development
HOST=0.0.0.0
PORT=5100

SECRET_KEY=change-me-filter-control-plane
JWT_SECRET=change-me-jwt-secret
# JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///fcp.db

# 控制平面默认管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 跨域：逗号分隔。同机托管 web/dist 可留空。
# 开发若前端直连后端可写：http://127.0.0.1:5173
CORS_ORIGINS=

# 登录限流（同 IP；0=关闭）。反向代理已剥伪造头后再开 TRUST_PROXY_HEADERS=1
# LOGIN_RATE_LIMIT_MAX=20
# LOGIN_RATE_WINDOW_SECONDS=300
# TRUST_PROXY_HEADERS=0

# 独占下游：auto | mock | data818
# auto：DATA818 齐 → data818；否则 mock
# 显式 DOWNSTREAM=data818 缺凭证会启动失败（不静默回退）
DOWNSTREAM=auto

# data818 下游（可选）
# BASE 用 API 根，例如 https://api.818gzs.ai （不要填前台 www）
# TOKEN：登录 JWT（浏览器 Authorization，带 exp）→ 列表/订单/价目/公告/账单
# AGENT_TOKEN：超管签发 agent_token（exp 常为 null）→ /api/filter/* 建任务/类型/余额/下载
# 818 两套 JWT 密钥不同，缺一则对应半边接口 401
# 也可在系统页热更新 Token（downstream_secrets.json，优先于本文件）
DATA818_BASE_URL=
DATA818_TOKEN=
DATA818_AGENT_TOKEN=
DATA818_TIMEOUT=60
# getDownloadPathById 返回相对 path 时拼接（默认 818 OSS 公网）
DATA818_OSS_PUBLIC_BASE=https://168filter.oss-cn-hongkong.aliyuncs.com

# APP_VERSION=0.1.0
